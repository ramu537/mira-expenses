# Leave this unset in local development to use Vite's /api proxy.
# For a deployed app, point it at the existing Mira backend, including /api.
VITE_API_URL=https://api.your-domain.com/api

# Local proxy target. This is read only by Vite and is never exposed to the browser.
MIRA_API_PROXY_TARGET=https://129-159-232-38.sslip.io

